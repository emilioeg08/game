<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- Merged into gx_game.exe by the linker (ADR-034). UTF-8 as the process code page: narrow Win32 and C
     runtime calls (fopen, getenv...) then take UTF-8, like the rest of the engine. SDL3 sets the DPI
     awareness at run time. -->
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0" xmlns:asmv3="urn:schemas-microsoft-com:asm.v3">
  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 10 and 11 -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}"/>
    </application>
  </compatibility>
  <asmv3:application>
    <asmv3:windowsSettings xmlns="http://schemas.microsoft.com/SMI/2019/WindowsSettings">
      <activeCodePage>UTF-8</activeCodePage>
    </asmv3:windowsSettings>
  </asmv3:application>
</assembly>
